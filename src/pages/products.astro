---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Products">
  <main id="main-content" class="page-main">
    <section class="page-intro" aria-labelledby="page-title">
      <p class="page-intro__eyebrow">Products</p>
      <h1 id="page-title">Software in progress.</h1>
      <p class="page-intro__body">
        PAKO Analytics develops proprietary software for practical challenges.
      </p>
      <article class="product-note" aria-labelledby="product-title">
        <div>
          <h2 id="product-title">DrillCanvas</h2>
          <p>Browser-based marching band drill design and visualization.</p>
        </div>
        <span class="alpha-label">Closed alpha</span>
      </article>
    </section>
  </main>
</SiteLayout>
