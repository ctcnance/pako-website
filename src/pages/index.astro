---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../data/site";
---

<SiteLayout>
  <main id="main-content">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__inner">
        <div class="hero-copy">
          <p class="hero-eyebrow">PAKO Analytics</p>
          <h1 id="home-title">{site.tagline}</h1>
          <p class="hero-copy__description">{site.description}</p>
          <div class="hero-actions">
            <a class="button button--primary" href="/products"
              >Explore Our Products</a
            >
            <a class="button button--secondary" href="/about">About PAKO</a>
          </div>
        </div>

        <article class="product-preview" aria-labelledby="drillcanvas-title">
          <div class="product-preview__heading">
            <h2 id="drillcanvas-title" class="product-preview__name">
              DrillCanvas
            </h2>
            <span class="alpha-label">Closed alpha</span>
          </div>
          <div
            class="field-preview"
            role="img"
            aria-label="Illustrative marching band drill formation on a field grid"
          >
            {
              Array.from({ length: 30 }, () => (
                <span class="field-preview__mark" />
              ))
            }
          </div>
          <p class="product-preview__caption">
            Browser-based marching band drill design and visualization.
          </p>
        </article>
      </div>
    </section>

    <section class="intro-strip" aria-labelledby="intro-title">
      <h2 id="intro-title">Built around practical challenges.</h2>
      <p>
        PAKO Analytics develops software, explores data-driven solutions, and
        builds technology designed to solve practical challenges.
      </p>
    </section>
  </main>
</SiteLayout>
